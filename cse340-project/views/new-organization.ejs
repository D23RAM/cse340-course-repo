
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">ORGANIZATION MANAGEMENT</p>
        <h1>Create an Organization</h1>
        <p>Add a new partner organization to Community Connect.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">

            <% if (messages && messages.error && messages.error.length > 0) { %>
                <div class="error-message" role="alert">
                    <strong>Please correct the following errors:</strong>
                    <ul>
                        <% messages.error.forEach(message => { %>
                            <li><%= message %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/new-organization" method="POST" novalidate>

                <div class="form-group">
                    <label for="name">Organization Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= organization.name || '' %>"
                        maxlength="150"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        required
                    ><%= organization.description || '' %></textarea>
                </div>

                <div class="form-group">
                    <label for="contact_email">Contact Email</label>
                    <input
                        type="email"
                        id="contact_email"
                        name="contact_email"
                        value="<%= organization.contact_email || '' %>"
                        maxlength="255"
                        required
                    >
                </div>

                <button type="submit" class="btn">Create Organization</button>
                <a href="/organizations">Cancel</a>

            </form>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
