
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">OUR PARTNERS</p>
        <h1><%= organizationDetails.name %></h1>
        <p>Learn more about our partner organization and its community projects.</p>
    </div>
</section>

<section class="section">
    <div class="container">

        <article class="info-card">
            <img
                src="/images/<%= organizationDetails.logo_filename %>"
                alt="<%= organizationDetails.name %> logo"
                class="organization-image"
            >

            <h2><%= organizationDetails.name %></h2>

            <p><%= organizationDetails.description %></p>

            <p>
                <strong>Contact:</strong>
                <a href="mailto:<%= organizationDetails.contact_email %>">
                    <%= organizationDetails.contact_email %>
                </a>
            </p>
        </article>

        <div class="section">
            <h2>Service Projects</h2>

            <% if (projects.length > 0) { %>
                <div class="card-grid">
                    <% projects.forEach(project => { %>
                        <article class="info-card">
                            <h3><%= project.title %></h3>
                            <p><%= project.description %></p>
                            <p><strong>Location:</strong> <%= project.location %></p>
                            <p>
                                <strong>Date:</strong>
                                <%= new Date(project.date).toLocaleDateString() %>
                            </p>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <p>This organization does not have any service projects yet.</p>
            <% } %>

        </div>

        <a href="/organizations" class="text-link">
            &larr; Back to all organizations
        </a>

    </div>
</section>

<%- include("partials/footer") %>
