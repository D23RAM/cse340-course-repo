
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">ORGANIZATION MANAGEMENT</p>
        <h1>Edit Organization</h1>
        <p>Update the information for this partner organization.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">

            <% if (messages && messages.error && messages.error.length > 0) { %>
                <div class="error-message" role="alert">
                    <strong>Please correct the following errors:</strong>
                    <ul>
                        <% messages.error.forEach(message => { %>
                            <li><%= message %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form
                action="/edit-organization/<%= organization.organization_id %>"
                method="POST"
            >

                <div class="form-group">
                    <label for="name">Organization Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= organization.name || '' %>"
                        maxlength="150"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        required
                    ><%= organization.description || '' %></textarea>
                </div>

                <div class="form-group">
                    <label for="contact_email">Contact Email</label>
                    <input
                        type="email"
                        id="contact_email"
                        name="contact_email"
                        value="<%= organization.contact_email || '' %>"
                        maxlength="255"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Current Organization Image</label>
                    <img
                        src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"
                        style="max-width: 180px; max-height: 140px; object-fit: contain;"
                    >
                </div>

                <div class="form-group">
                    <label for="logo_filename">Logo Filename</label>
                    <input
                        type="text"
                        id="logo_filename"
                        name="logo_filename"
                        value="<%= organization.logo_filename || '' %>"
                        maxlength="255"
                        required
                    >
                    <small>
                        Enter an existing image filename from your public/images folder.
                        For example: community.svg
                    </small>
                </div>

                <button type="submit" class="btn">Save Changes</button>
                <a href="/organizations">Cancel</a>

            </form>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
