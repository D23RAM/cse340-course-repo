
<%- include("partials/header", {title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">GET INVOLVED</p>
        <h1>Upcoming Service Projects</h1>
        <p>
            Discover opportunities to make a difference in your community.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="eyebrow">MAKE AN IMPACT</p>
        <h2>Upcoming Service Projects</h2>

        <div class="card-grid">
            <% projects.forEach(project => { %>
                <article class="info-card">
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <strong>Organization:</strong>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p><strong>Date:</strong>
                        <%= new Date(project.date).toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                            timeZone: "UTC"
                        }) %>
                    </p>

                    <p><%= project.description %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                </article>
            <% }); %>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
