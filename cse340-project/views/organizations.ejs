
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">OUR PARTNERS</p>
        <h1>Partner Organizations</h1>
        <p>
            Meet the organizations working with us to make a positive
            difference through community service.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="eyebrow">WORKING TOGETHER</p>
        <h2>Our Partner Organizations</h2>
        <p class="section-description">
            Here are a few of our partner organizations:
        </p>

        <div class="card-grid">

            <article class="info-card">
                <img
                    src="/images/brightfuture-logo.png"
                    alt="BrightFuture Builders logo"
                    class="organization-image"
                >
                <h3>BrightFuture Builders</h3>
                <p>
                    Get involved with BrightFuture Builders and support
                    its community service initiatives.
                </p>
                <a href="mailto:info@brightfuture.org" class="text-link">
                    info@brightfuture.org
                </a>
            </article>

            <article class="info-card">
                <img
                    src="/images/greenharvest-logo.png"
                    alt="GreenHarvest Growers logo"
                    class="organization-image"
                >
                <h3>GreenHarvest Growers</h3>
                <p>
                    Connect with GreenHarvest Growers and learn more
                    about its service opportunities.
                </p>
                <a href="mailto:contact@greenharvest.org" class="text-link">
                    contact@greenharvest.org
                </a>
            </article>

            <article class="info-card">
                <img
                    src="/images/unityserve-logo.png"
                    alt="UnityServe Volunteers logo"
                    class="organization-image"
                >
                <h3>UnityServe Volunteers</h3>
                <p>
                    Discover opportunities to contribute your time
                    and make a difference with UnityServe Volunteers.
                </p>
                <a href="mailto:hello@unityserve.org" class="text-link">
                    hello@unityserve.org
                </a>
            </article>

        </div>
    </div>
</section>

<%- include("partials/footer") %>
