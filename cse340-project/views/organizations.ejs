
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">OUR PARTNERS</p>
        <h1>Partner Organizations</h1>
        <p>
            Meet the organizations working with us to make a positive
            difference through community service.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">

        <% if (messages && messages.success && messages.success.length > 0) { %>
            <div class="success-message">
                <% messages.success.forEach(message => { %>
                    <p><%= message %></p>
                <% }) %>
            </div>
        <% } %>

        <p class="eyebrow">WORKING TOGETHER</p>
        <h2>Our Partner Organizations</h2>
        <p class="section-description">
            Here are our partner organizations:
        </p>

        <div class="section-heading">
            <a href="/new-organization" class="btn">
                + Create New Organization
            </a>
        </div>

        <div class="card-grid">
            <% if (organizations && organizations.length > 0) { %>
                <% organizations.forEach(organization => { %>
                    <article class="info-card">

                        <img
                            src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.name %> logo"
                            class="organization-image"
                        >

                        <h3>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h3>

                        <p><%= organization.description %></p>

                        <a
                            href="mailto:<%= organization.contact_email %>"
                            class="text-link"
                        >
                            <%= organization.contact_email %>
                        </a>

                        <p>
                            <a
                                href="/organization/<%= organization.organization_id %>"
                                class="text-link"
                            >
                                View Organization Details &rarr;
                            </a>
                        </p>

                        <a
                            href="/edit-organization/<%= organization.organization_id %>"
                            class="btn"
                        >
                            Edit Organization
                        </a>

                    </article>
                <% }) %>
            <% } else { %>
                <p>No organizations have been added yet.</p>
            <% } %>
        </div>

    </div>
</section>

<%- include("partials/footer") %>
