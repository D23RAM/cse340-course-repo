<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">DISCOVER</p>
        <h1>Organizations</h1>
        <p>Meet organizations making a positive difference in their communities.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="card-grid">

            <article class="info-card">
                <img src="/images/greenharvest-logo.png"
                     alt="Environmental organization"
                     class="organization-image">
                <h3>Environmental Organizations</h3>
                <p>Discover organizations working to protect nature and promote sustainability.</p>
            </article>

            <article class="info-card">
                <img src="/images/brightfuture-logo.png"
                     alt="Educational organization"
                     class="organization-image">
                <h3>Educational Organizations</h3>
                <p>Explore organizations supporting education and learning.</p>
            </article>

            <article class="info-card">
                <img src="/images/unityserve-logo.png"
                     alt="Community organization"
                     class="organization-image">
                <h3>Community Organizations</h3>
                <p>Learn about organizations helping people and strengthening communities.</p>
            </article>

        </div>
    </div>
</section>

<%- include("partials/footer") %>