
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">OUR PARTNERS</p>
        <h1>Partner Organizations</h1>
        <p>
            Meet the organizations working with us to make a positive
            difference through community service.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <p class="eyebrow">WORKING TOGETHER</p>
        <h2>Our Partner Organizations</h2>
        <p class="section-description">
            Here are a few of our partner organizations:
        </p>

        <div class="card-grid">

            <% organizations.forEach(organization => { %>

                <article class="info-card">
                    <img
                        src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"
                        class="organization-image"
                    >

                    <h3><%= organization.name %></h3>

                    <p>
                        <%= organization.description %>
                    </p>

                    <a
                        href="mailto:<%= organization.contact_email %>"
                        class="text-link"
                    >
                        <%= organization.contact_email %>
                    </a>
                </article>

            <% }); %>

        </div>
    </div>
</section>

<%- include("partials/footer") %>
