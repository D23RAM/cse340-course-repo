
<%- include("partials/header", { title: title }) %>

<section class="hero">
    <div class="container hero-content">

        <img
            src="/images/cse340-service-network.png"
            alt="CSE 340 Service Network logo"
            class="home-logo"
        >

        <p class="eyebrow">MAKE A DIFFERENCE</p>

        <h1>Small actions.<br>Big impact.</h1>

        <p class="hero-description">
            Discover organizations, explore service projects,
            and find meaningful ways to give back to your community.
        </p>

        <div class="hero-buttons">
            <a href="/organizations" class="btn btn-primary">
                Explore Organizations
            </a>

            <a href="/projects" class="btn btn-secondary">
                View Projects
            </a>
        </div>

    </div>
</section>

<section class="section">
    <div class="container">

        <p class="eyebrow">GET INVOLVED</p>

        <h2>Find your way to make an impact.</h2>

        <p class="section-description">
            Whether you want to volunteer, support a cause, or learn more,
            there is an opportunity waiting for you.
        </p>

        <div class="card-grid">

            <article class="info-card">
                <div class="card-icon">01</div>
                <h3>Organizations</h3>
                <p>Discover organizations working to improve communities.</p>
                <a href="/organizations" class="text-link">
                    Explore organizations →
                </a>
            </article>

            <article class="info-card">
                <div class="card-icon">02</div>
                <h3>Service Projects</h3>
                <p>Find projects where you can contribute your time and skills.</p>
                <a href="/projects" class="text-link">
                    Explore projects →
                </a>
            </article>

            <article class="info-card">
                <div class="card-icon">03</div>
                <h3>Categories</h3>
                <p>Explore different causes and areas of community service.</p>
                <a href="/categories" class="text-link">
                    Browse categories →
                </a>
            </article>

        </div>
    </div>
</section>

<%- include("partials/footer") %>
