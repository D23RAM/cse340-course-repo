
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">PROJECT MANAGEMENT</p>
        <h1>Assign Categories</h1>
        <p>Select the categories that best describe this service project.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">
            <h2><%= project.title %></h2>

            <% if (messages.error && messages.error.length > 0) { %>
                <div class="error-message" role="alert">
                    <ul>
                        <% messages.error.forEach(error => { %>
                            <li><%= error %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form
                action="/project/<%= project.project_id %>/categories"
                method="POST"
                novalidate
            >
                <fieldset>
                    <legend>Available Categories</legend>

                    <% if (allCategories.length > 0) { %>
                        <% allCategories.forEach(category => { %>
                            <div class="form-group">
                                <label>
                                    <input
                                        type="checkbox"
                                        name="category_ids"
                                        value="<%= category.category_id %>"
                                        <%= assignedIds.includes(Number(category.category_id)) ? "checked" : "" %>
                                    >
                                    <%= category.name %>
                                </label>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No categories are available. Create a category first.</p>
                    <% } %>
                </fieldset>

                <button type="submit">Save Categories</button>
            </form>

            <p>
                <a href="/project/<%= project.project_id %>">
                    ← Back to Project
                </a>
            </p>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
