
<%- include("partials/header", {title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">EXPLORE SERVICE PROJECTS</p>
        <h1><%= category.name %></h1>
        <p>
            Discover service opportunities connected to this category
            and find ways to make a difference in your community.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2>Projects in <%= category.name %></h2>

        <% if (projects.length > 0) { %>
            <div class="card-grid">

                <% projects.forEach(project => { %>
                    <article class="info-card">
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Partner Organization:</strong>
                            <%= project.organization_name %>
                        </p>

                        <a href="/project/<%= project.project_id %>">
                            View Project Details →
                        </a>
                    </article>
                <% }) %>

            </div>
        <% } else { %>
            <p>There are currently no projects in this category.</p>
        <% } %>

        <p>
            <a href="/categories">← Back to Categories</a>
        </p>
    </div>
</section>

<%- include("partials/footer") %>
