
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">COMMUNITY CONNECT</p>
        <h1>Create New Category</h1>
        <p>Add a new category to help organize community service projects.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">
            <h2>Category Information</h2>

            <% if (messages && messages.error && messages.error.length > 0) { %>
                <div class="error-message" role="alert">
                    <strong>Please correct the following errors:</strong>
                    <ul>
                        <% messages.error.forEach(message => { %>
                            <li><%= message %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/new-category" method="POST" novalidate>

                <div class="form-group">
                    <label for="name">Category Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= category.name || '' %>"
                        required
                        minlength="3"
                        maxlength="100"
                    >
                </div>

                <button type="submit" class="btn">Create Category</button>
            </form>

            <p><a href="/categories">← Back to Categories</a></p>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
