
<%- include("partials/header", {title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">SERVICE PROJECT DETAILS</p>
        <h1><%= project.title %></h1>
        <p>
            Discover how you can make a difference in your community.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">
            <h2><%= project.title %></h2>

            <p><%= project.description %></p>

            <p>
                <strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC"
                }) %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p>
                <strong>Partner Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <div class="project-categories">
                <h3>Categories</h3>

                <% if (categories.length > 0) { %>
                    <div class="category-tags">
                        <% categories.forEach(category => { %>
                            <a
                                class="category-tag"
                                href="/category/<%= category.category_id %>"
                            >
                                <%= category.name %>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p>No categories assigned to this project.</p>
                <% } %>
            </div>

            <a href="/projects">Back to Upcoming Projects</a>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
