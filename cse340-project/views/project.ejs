
<%- include("partials/header", {title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">SERVICE PROJECT DETAILS</p>
        <h1><%= project.title %></h1>
        <p>
            Discover how you can make a difference in your community.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">
            <h2><%= project.title %></h2>

            <p><%= project.description %></p>

            <p>
                <strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC"
                }) %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p>
                <strong>Partner Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <a href="/projects">Back to Upcoming Projects</a>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
