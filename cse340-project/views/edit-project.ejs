
<%- include("partials/header", { title: title }) %>

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">PROJECT MANAGEMENT</p>
        <h1>Edit Service Project</h1>
        <p>Update the details of this community service opportunity.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="info-card">

            <% if (messages && messages.error && messages.error.length > 0) { %>
                <div class="error-message" role="alert">
                    <strong>Please correct the following errors:</strong>
                    <ul>
                        <% messages.error.forEach(message => { %>
                            <li><%= message %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form
                action="/edit-project/<%= project.project_id %>"
                method="POST"
                novalidate
            >

                <div class="form-group">
                    <label for="title">Project Title</label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= project.title || '' %>"
                        maxlength="150"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        required
                    ><%= project.description || '' %></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        value="<%= project.location || '' %>"
                        maxlength="255"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="date">Project Date</label>
                    <input
                        type="date"
                        id="date"
                        name="date"
                        value="<%= project.date || '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="organization_id">Partner Organization</label>
                    <select
                        id="organization_id"
                        name="organization_id"
                        required
                    >
                        <option value="">Select an organization</option>

                        <% organizations.forEach(organization => { %>
                            <option
                                value="<%= organization.organization_id %>"
                                <%= String(project.organization_id) === String(organization.organization_id) ? "selected" : "" %>
                            >
                                <%= organization.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="btn">Save Changes</button>
                <a href="/projects">Cancel</a>

            </form>

        </div>
    </div>
</section>

<%- include("partials/footer") %>
